//helper
void send_led_state(uint8_t led_pattern) {
    gpio_put(17, 0);
    spi_write_blocking(spi0, &led_pattern, 1);
    gpio_put(17, 1);
}

// task struct
typedef struct _task {
    signed char state;
    unsigned long period;
    unsigned long elapsedTime;
    int (*TickFct)(int);
} task;

// variables
#define NUM_TASKS 4
unsigned char animationToggle = 0; // animation one = 0, animation two = 1

//const unsigned long GCD_PERIOD = 100;

task tasks[NUM_TASKS];

// scheduler
bool Tick(struct repeating_timer *t) {
    for (unsigned int i = 0; i < NUM_TASKS; i++) {
        if (tasks[i].elapsedTime >= tasks[i].period) {
            tasks[i].state = tasks[i].TickFct(tasks[i].state);
            tasks[i].elapsedTime = 0;
        }
        tasks[i].elapsedTime += 100;
    }
    return true;
}

// Task setup
enum ANIMATION_ONE { ANIMATION_ONE_INIT, ANIMATION_ONE_STEP1, ANIMATION_ONE_STEP2 } ANIMATION_ONE_state;

int ANIMATION_ONE_Tick(int state) {
    if(animationToggle == 0) { // if animation toggle is 0, run animation one, otherwise run animation two
        return state;
    }
    // Transitions
    switch (state) {
        case ANIMATION_ONE_INIT:
            gpio_put_masked(0b111100, 0b000000);
            send_led_state(0b00000000);

            state = ANIMATION_ONE_STEP1;
            break;
        case ANIMATION_ONE_STEP1:
            state = ANIMATION_ONE_STEP2;
            break;
        case ANIMATION_ONE_STEP2:
            state = ANIMATION_ONE_STEP1;
            break;
        default:
            break;
    }
    // Actions
    switch (state) {
        case ANIMATION_ONE_INIT:
            break;
        case ANIMATION_ONE_STEP1:
            gpio_put_masked(0b111100, 0b101000);
            send_led_state(0b10100000);
            break;
        case ANIMATION_ONE_STEP2:
            gpio_put_masked(0b111100, 0b010100);
            send_led_state(0b01010000);
            break;
        default:
            break;
    }
    return state;
}

uint8_t snake_patterns[] = {
    0b00000000,  // 0 LEDs
    0b00000001,  // 1 LED
    0b00000011,  // 2 LEDs
    0b00000111,  // 3 LEDs
    0b00001111,  // 4 LEDs
    0b00011111,  // 5 LEDs
    0b00111111,  // 6 LEDs
    0b01111111,  // 7 LEDs
    0b11111111   // 8 LEDs
};

enum ANIMATION_TWO { ANIMATION_TWO_INIT, ANIMATION_TWO_STEP1 } ANIMATION_TWO_state;

int ANIMATION_TWO_Tick(int state) {
    static unsigned char numLit = 0;

    if(animationToggle == 1) {
        return state;
    }
    // Transitions
    switch (state) {
        case ANIMATION_TWO_INIT:
            gpio_put_masked(0b111100, 0b000000);
            send_led_state(0b00000000);
            numLit = 0;

            state = ANIMATION_TWO_STEP1;
            break;
        case ANIMATION_TWO_STEP1:
            break;
        default:
            break;
    }
    // Actions
    switch (state) {
        case ANIMATION_TWO_INIT:
            break;
        case ANIMATION_TWO_STEP1:
            if ( numLit >= 9 ) numLit = 0;
            gpio_put_masked(0b111100, (snake_patterns[numLit] & 0b00001111) << 2); // light more on
            send_led_state(snake_patterns[numLit] & 0b11110000);
            numLit = numLit + 1;
            break;
        default:
            break;
    }
    return state;
}

int dipSwitchState(int state) {
    int animationTogglePrev = animationToggle;

    animationToggle = gpio_get(0); // read dip switch state

    if(animationTogglePrev != animationToggle) { // New animation
        tasks[0].state = ANIMATION_ONE_INIT; 
        tasks[1].state = ANIMATION_TWO_INIT;
    }

    return state;
}

// helper function to map adc
long map(long x, long in_min, long in_max, long out_min, long out_max) {
    return (x - in_min) * (out_max - out_min) / (in_max - in_min) + out_min;
}

// Exercise 3
int adc_read_and_update(int state) {
    uint16_t adc_value = adc_read();
    unsigned long speed = map(adc_value, 0, 4095, 100, 1000); // 100ms to 1000ms
    tasks[0].period = speed; // update animation one speed
    tasks[1].period = speed; // update animation two speed
    return state;
}

